# Robinhood Chain mainnet RPC endpoint (chain ID 4663)
VITE_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Mainnet chain identifiers used by wallet/UI checks
VITE_CHAIN_ID=4663
VITE_RH_CHAIN_ID=4663

# Optional indexer endpoint. Without it, the UI uses the on-chain SDK where available
# and a small local preview dataset for layout development.
VITE_PROTO_INDEXER_URL=

# Image uploads are proxied through the indexer; never put a Pinata JWT in Vite env.
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
